# ------------------------------------------------------------
# Copy this file to ".env" in the same folder and fill in values.
# NEVER commit the real ".env" file to Git.
# ------------------------------------------------------------

# MySQL connection string.
# Format: mysql://USER:PASSWORD@HOST:PORT/DATABASE_NAME
# Default XAMPP MySQL user is "root" with an EMPTY password.
DATABASE_URL="mysql://root:@localhost:3306/phone_accessories_shop"

# Secret used to sign JWT tokens. Change this to a long random string.
JWT_SECRET="CHANGE_THIS_SECRET_TO_A_LONG_RANDOM_STRING"

# How long an admin login session stays valid.
JWT_EXPIRES_IN="7d"

# Port the Express API server will run on.
PORT=5000

# The URL of the React frontend (used for CORS).
CLIENT_URL="http://localhost:5173"

# Where uploaded product images are stored on disk.
UPLOAD_DIR="./uploads"

# Node environment
NODE_ENV="development"
